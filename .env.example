# Copy this file to .env and fill in real values. .env is gitignored and
# loaded automatically at startup (see app/llm_config.py, app/main.py).

# Required for real LLM generation (app/nodes/llm_generation.py) and RAG
# retrieval embeddings (app/nodes/rag_retrieval.py). Without it, both nodes
# fall back to stub behavior and log a warning.
OPENAI_API_KEY=

# Set to true/1/yes ONLY if you hit
# "SSL: CERTIFICATE_VERIFY_FAILED: unable to get local issuer certificate"
# (common on corporate networks with an SSL-inspecting proxy). This skips
# TLS certificate verification for OpenAI API calls - do NOT enable this
# in production, it disables protection against man-in-the-middle attacks.
OPENAI_SKIP_SSL_VERIFY=false

# Optional: enable LangSmith tracing to visualize graph runs (nodes, edges,
# interrupts, retries) at https://smith.langchain.com. Get an API key from
# your LangSmith account settings. No code changes required - LangChain/
# LangGraph auto-instrument when these are set.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=capstone-test-case-gen

# TODO: add Aha! and TestRail credentials here once app/tools/aha_tools.py
# and app/tools/testrail_tools.py are implemented, e.g.:
# AHA_API_KEY=
# AHA_SUBDOMAIN=
# TESTRAIL_URL=
# TESTRAIL_USERNAME=
# TESTRAIL_API_KEY=
